        <rdfs:comment>A keyboard instrument producing melodic notes via hammers striking interior metal strings</rdfs:comment>
        <rdfs:label>Piano</rdfs:label>
    </owl:Class>
    


    <!-- http://example.org/music-ontology#PopGenre -->

    <owl:Class rdf:about="http://example.org/music-ontology#PopGenre">
        <rdfs:subClassOf rdf:resource="http://example.org/music-ontology#Genre"/>
        <rdfs:comment>A stylistic popular commercial music genre grouping classification</rdfs:comment>
        <rdfs:label>PopGenre</rdfs:label>
    </owl:Class>
    


    <!-- http://example.org/music-ontology#Producer -->

    <owl:Class rdf:about="http://example.org/music-ontology#Producer">
        <rdfs:subClassOf rdf:resource="http://example.org/music-ontology#Person"/>
        <rdfs:comment>A person expert handling technical mixing, recording, or audio production guidance</rdfs:comment>
        <rdfs:label>Producer</rdfs:label>
    </owl:Class>
    


    <!-- http://example.org/music-ontology#ProductionParticipation -->

    <owl:Class rdf:about="http://example.org/music-ontology#ProductionParticipation">
        <rdfs:subClassOf rdf:resource="http://example.org/music-ontology#Participation"/>
        <rdfs:comment>A specialized participation pattern node detailing technical studio production involvement</rdfs:comment>
        <rdfs:label>ProductionParticipation</rdfs:label>
    </owl:Class>
    


    <!-- http://example.org/music-ontology#Program -->

    <owl:Class rdf:about="http://example.org/music-ontology#Program">
        <rdfs:subClassOf rdf:resource="http://example.org/music-ontology#MusicWork"/>
        <rdfs:comment xml:lang="en">ODP: Part-Of Pattern. A Program is a MusicWork composed of ProgramItems (individual Track performances), ordered by position. This reifies the part-whole relationship between a Concert&apos;s program and its constituent tracks.</rdfs:comment>
        <rdfs:label>Program</rdfs:label>
    </owl:Class>
    


    <!-- http://example.org/music-ontology#ProgramItem -->

    <owl:Class rdf:about="http://example.org/music-ontology#ProgramItem">
        <rdfs:subClassOf rdf:resource="http://example.org/music-ontology#MusicWork"/>
        <rdfs:comment>The part element inside a concert program representing one distinct song item executed on stage</rdfs:comment>
        <rdfs:label>ProgramItem</rdfs:label>
    </owl:Class>
    


    <!-- http://example.org/music-ontology#RapGenre -->

    <owl:Class rdf:about="http://example.org/music-ontology#RapGenre">
        <rdfs:subClassOf rdf:resource="http://example.org/music-ontology#Genre"/>
        <rdfs:comment>genre of popular music featuring rhythmic, rhyming spoken vocals delivered over a backing beat or musical track</rdfs:comment>
        <rdfs:label>RapGenre</rdfs:label>
    </owl:Class>
    


    <!-- http://example.org/music-ontology#RecordLabel -->

    <owl:Class rdf:about="http://example.org/music-ontology#RecordLabel">
