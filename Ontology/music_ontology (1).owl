<?xml version="1.0"?>
<rdf:RDF xmlns="http://example.org/music-ontology#"
     xml:base="http://example.org/music-ontology"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:obda="https://w3id.org/obda/vocabulary#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:dcterms="http://example.org/music-ontology#dcterms:">
    <owl:Ontology rdf:about="http://example.org/music-ontology">
        <rdfs:comment xml:lang="en">Enhanced Music Ontology for SAIKS Assignment SS2026 Group F. Covers concerts, tracks, composers, events, musicians, orchestras, theaters, instruments, albums, genres, tours, venues, and record labels. Uses OWL2 advanced features and three Ontology Design Patterns: Participation, Part-Of, and Typed Situation.</rdfs:comment>
        <rdfs:label xml:lang="en">Concerts and Music Ontology</rdfs:label>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://example.org/music-ontology#dcterms:license -->

    <owl:AnnotationProperty rdf:about="http://example.org/music-ontology#dcterms:license"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Datatypes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.w3.org/2001/XMLSchema#date -->

    <rdfs:Datatype rdf:about="http://www.w3.org/2001/XMLSchema#date"/>
    


    <!-- http://www.w3.org/2001/XMLSchema#gYear -->

    <rdfs:Datatype rdf:about="http://www.w3.org/2001/XMLSchema#gYear"/>
    


    <!-- http://www.w3.org/2001/XMLSchema#time -->

    <rdfs:Datatype rdf:about="http://www.w3.org/2001/XMLSchema#time"/>
    


    <!-- xsd:decimal -->

    <rdfs:Datatype rdf:about="xsd:decimal"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://example.org/music-ontology#awardGivenTo -->

    <owl:ObjectProperty rdf:about="http://example.org/music-ontology#awardGivenTo">
        <owl:inverseOf rdf:resource="http://example.org/music-ontology#receivedAward"/>
        <rdfs:domain rdf:resource="http://example.org/music-ontology#Award"/>
        <rdfs:range rdf:resource="http://example.org/music-ontology#Person"/>
        <rdfs:comment>Relates an award instance to the person who received it.</rdfs:comment>
        <rdfs:label>awardGivenTo</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://example.org/music-ontology#collaboratedWith -->

    <owl:ObjectProperty rdf:about="http://example.org/music-ontology#collaboratedWith">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ReflexiveProperty"/>
        <rdfs:domain rdf:resource="http://example.org/music-ontology#Musician"/>
        <rdfs:range rdf:resource="http://example.org/music-ontology#Musician"/>
        <rdfs:comment>Indicates a direct mutual creative collaboration between two musicians</rdfs:comment>
        <rdfs:label>collaboratedWith</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://example.org/music-ontology#createdWork -->

    <owl:ObjectProperty rdf:about="http://example.org/music-ontology#createdWork">
        <owl:inverseOf rdf:resource="http://example.org/music-ontology#hasCreator"/>
        <rdfs:domain rdf:resource="http://example.org/music-ontology#Person"/>
        <rdfs:range rdf:resource="http://example.org/music-ontology#MusicWork"/>
        <rdfs:comment>Links a person to a musical work they authored, composed, or created</rdfs:comment>
        <rdfs:label>createdWork</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://example.org/music-ontology#featuresInstrument -->

    <owl:ObjectProperty rdf:about="http://example.org/music-ontology#featuresInstrument">
        <owl:inverseOf rdf:resource="http://example.org/music-ontology#isFeaturedIn"/>
        <rdfs:range rdf:resource="http://example.org/music-ontology#Instrument"/>
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="http://example.org/music-ontology#hasMember"/>
            <rdf:Description rdf:about="http://example.org/music-ontology#playsInstrument"/>
        </owl:propertyChainAxiom>
        <rdfs:comment>Infers the instruments featured within a musical group based on what its active members play.
PropertyChain: hasMember o playsInstrument</rdfs:comment>
        <rdfs:label>featuresInstrument</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://example.org/music-ontology#hasCreator -->

    <owl:ObjectProperty rdf:about="http://example.org/music-ontology#hasCreator">
        <rdfs:domain rdf:resource="http://example.org/music-ontology#MusicWork"/>
        <rdfs:range rdf:resource="http://example.org/music-ontology#Person"/>
        <rdfs:comment>Identifies the human author or composer responsible for a music work</rdfs:comment>
        <rdfs:label>hasCreator</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://example.org/music-ontology#hasGenre -->

    <owl:ObjectProperty rdf:about="http://example.org/music-ontology#hasGenre">
        <owl:inverseOf rdf:resource="http://example.org/music-ontology#isGenreOf"/>
        <rdfs:domain rdf:resource="http://example.org/music-ontology#MusicWork"/>
        <rdfs:range rdf:resource="http://example.org/music-ontology#Genre"/>
        <rdfs:comment>Classifies a music work under a specific stylistic musical genre</rdfs:comment>
        <rdfs:label>hasGenre</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://example.org/music-ontology#hasMember -->

    <owl:ObjectProperty rdf:about="http://example.org/music-ontology#hasMember">
        <owl:inverseOf rdf:resource="http://example.org/music-ontology#isMemberOf"/>
        <rdfs:range rdf:resource="http://example.org/music-ontology#Musician"/>
        <rdfs:comment>Links a collective ensemble like a band or orchestra to its constituent individual musicians</rdfs:comment>
        <rdfs:label>hasMember</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://example.org/music-ontology#hasParticipant -->

    <owl:ObjectProperty rdf:about="http://example.org/music-ontology#hasParticipant">
        <owl:inverseOf rdf:resource="http://example.org/music-ontology#participatesIn"/>
        <rdfs:domain rdf:resource="http://example.org/music-ontology#Event"/>
        <rdfs:range rdf:resource="http://example.org/music-ontology#Person"/>
        <rdfs:comment>Connects a scheduled event directly to a human individual involved in it</rdfs:comment>
        <rdfs:label>hasParticipant</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://example.org/music-ontology#hasParticipation -->

    <owl:ObjectProperty rdf:about="http://example.org/music-ontology#hasParticipation">
        <owl:inverseOf rdf:resource="http://example.org/music-ontology#isParticipationOf"/>
        <rdfs:domain rdf:resource="http://example.org/music-ontology#Person"/>
        <rdfs:range rdf:resource="http://example.org/music-ontology#Participation"/>
        <rdfs:comment>Points a person toward their reified participation pattern wrapper</rdfs:comment>
        <rdfs:label>hasParticipation</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://example.org/music-ontology#hasProgramItem -->

    <owl:ObjectProperty rdf:about="http://example.org/music-ontology#hasProgramItem">
        <owl:inverseOf rdf:resource="http://example.org/music-ontology#isProgramItemOf"/>
        <rdfs:domain rdf:resource="http://example.org/music-ontology#Program"/>
        <rdfs:range rdf:resource="http://example.org/music-ontology#ProgramItem"/>
        <rdfs:comment>Relates a concert program layout directly to an individual track performance entry</rdfs:comment>
        <rdfs:label>hasProgramItem</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://example.org/music-ontology#hasReleased -->

    <owl:ObjectProperty rdf:about="http://example.org/music-ontology#hasReleased">
        <owl:inverseOf rdf:resource="http://example.org/music-ontology#releasedUnder"/>
        <rdfs:domain rdf:resource="http://example.org/music-ontology#RecordLabel"/>
        <rdfs:range rdf:resource="http://example.org/music-ontology#MusicWork"/>
        <rdfs:comment>Indicates that a record label corporate entity published an album or musical work</rdfs:comment>
        <rdfs:label>hasReleased</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://example.org/music-ontology#hasSetting -->

    <owl:ObjectProperty rdf:about="http://example.org/music-ontology#hasSetting">
        <owl:inverseOf rdf:resource="http://example.org/music-ontology#isSettingFor"/>
        <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:range rdf:resource="http://example.org/music-ontology#Situation"/>
        <rdfs:comment>Links contextual entities into their governing reified situation observation wrapper</rdfs:comment>
        <rdfs:label>hasSetting</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://example.org/music-ontology#hasTrack -->

    <owl:ObjectProperty rdf:about="http://example.org/music-ontology#hasTrack">
        <owl:inverseOf rdf:resource="http://example.org/music-ontology#trackIsPartOf"/>
        <rdfs:range rdf:resource="http://example.org/music-ontology#Track"/>
        <rdfs:comment>Relates an album or playlist to its individual track songs</rdfs:comment>
        <rdfs:label>hasTrack</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://example.org/music-ontology#hostedAt -->

    <owl:ObjectProperty rdf:about="http://example.org/music-ontology#hostedAt">
        <owl:inverseOf rdf:resource="http://example.org/music-ontology#hostedEvent"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://example.org/music-ontology#Event"/>
        <rdfs:range rdf:resource="http://example.org/music-ontology#Venue"/>
        <rdfs:comment>Binds a scheduled event to the physical location venue where it occurs</rdfs:comment>
        <rdfs:label>hostedAt</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://example.org/music-ontology#hostedEvent -->

    <owl:ObjectProperty rdf:about="http://example.org/music-ontology#hostedEvent">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#InverseFunctionalProperty"/>
        <rdfs:domain rdf:resource="http://example.org/music-ontology#Venue"/>
        <rdfs:range rdf:resource="http://example.org/music-ontology#Event"/>
        <rdfs:comment>Links a venue location to the specific scheduled events taking place inside it</rdfs:comment>
        <rdfs:label>hostedEvent</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://example.org/music-ontology#involvesMusicWork -->

    <owl:ObjectProperty rdf:about="http://example.org/music-ontology#involvesMusicWork">
        <owl:inverseOf rdf:resource="http://example.org/music-ontology#isMusicWorkInvolved"/>
        <rdfs:domain rdf:resource="http://example.org/music-ontology#Situation"/>
        <rdfs:range rdf:resource="http://example.org/music-ontology#MusicWork"/>
        <rdfs:comment>Declares that a musical work is an active element inside a reified situation</rdfs:comment>
        <rdfs:label>involvesMusicWork</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://example.org/music-ontology#involvesPerson -->

    <owl:ObjectProperty rdf:about="http://example.org/music-ontology#involvesPerson">
        <owl:inverseOf rdf:resource="http://example.org/music-ontology#isInvolvedInSituation"/>
        <rdfs:domain rdf:resource="http://example.org/music-ontology#Situation"/>
        <rdfs:range rdf:resource="http://example.org/music-ontology#Person"/>
        <rdfs:comment>Declares that a person is a key participant of reified situation wrapper</rdfs:comment>
        <rdfs:label>involvesPerson</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://example.org/music-ontology#isFeaturedIn -->

    <owl:ObjectProperty rdf:about="http://example.org/music-ontology#isFeaturedIn">
        <rdfs:domain rdf:resource="http://example.org/music-ontology#Instrument"/>
        <rdfs:comment>Inverse of FeaturesIntrument</rdfs:comment>
        <rdfs:label>isFeaturedIn</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://example.org/music-ontology#isGenreOf -->

    <owl:ObjectProperty rdf:about="http://example.org/music-ontology#isGenreOf">
        <rdfs:domain rdf:resource="http://example.org/music-ontology#Genre"/>
        <rdfs:range rdf:resource="http://example.org/music-ontology#MusicWork"/>
        <rdfs:comment>Inverse of hasGenre</rdfs:comment>
        <rdfs:label>isGenreOf</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://example.org/music-ontology#isInvolvedInSituation -->

    <owl:ObjectProperty rdf:about="http://example.org/music-ontology#isInvolvedInSituation">
        <rdfs:domain rdf:resource="http://example.org/music-ontology#Person"/>
        <rdfs:range rdf:resource="http://example.org/music-ontology#Situation"/>
        <rdfs:comment>Inverse of involvesPerson</rdfs:comment>
        <rdfs:label>isInvolvedInSituation</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://example.org/music-ontology#isMemberOf -->

    <owl:ObjectProperty rdf:about="http://example.org/music-ontology#isMemberOf">
        <rdfs:domain rdf:resource="http://example.org/music-ontology#Musician"/>
        <rdfs:comment>Connects an individual musician to the musical group or ensemble they play in</rdfs:comment>
        <rdfs:label>isMemberOf</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://example.org/music-ontology#isMusicWorkInvolved -->

    <owl:ObjectProperty rdf:about="http://example.org/music-ontology#isMusicWorkInvolved">
        <rdfs:domain rdf:resource="http://example.org/music-ontology#MusicWork"/>
        <rdfs:range rdf:resource="http://example.org/music-ontology#Situation"/>
        <rdfs:comment>Inverse of involvesMusicWork</rdfs:comment>
        <rdfs:label>isMusicWorkInvolved</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://example.org/music-ontology#isPartOfTour -->

    <owl:ObjectProperty rdf:about="http://example.org/music-ontology#isPartOfTour">
        <owl:inverseOf rdf:resource="http://example.org/music-ontology#occursDuring"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://example.org/music-ontology#Concert"/>
                    <rdf:Description rdf:about="http://example.org/music-ontology#MusicFestival"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://example.org/music-ontology#Tour"/>
        <rdfs:comment>Links concert with the tour it belongs to</rdfs:comment>
        <rdfs:label>isPartOfTour</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://example.org/music-ontology#isParticipationOf -->

    <owl:ObjectProperty rdf:about="http://example.org/music-ontology#isParticipationOf">
        <rdfs:domain rdf:resource="http://example.org/music-ontology#Participation"/>
        <rdfs:range rdf:resource="http://example.org/music-ontology#Person"/>
        <rdfs:comment>Links participation ODP wrapper block to its assigned human</rdfs:comment>
        <rdfs:label>isParticipationOf</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://example.org/music-ontology#isPerformedIn -->

    <owl:ObjectProperty rdf:about="http://example.org/music-ontology#isPerformedIn">
        <owl:inverseOf rdf:resource="http://example.org/music-ontology#performsTrack"/>
        <rdfs:domain rdf:resource="http://example.org/music-ontology#Track"/>
        <rdfs:range rdf:resource="http://example.org/music-ontology#Concert"/>
        <rdfs:comment>Maps a track song directly to the live concert instance where it was executed</rdfs:comment>
        <rdfs:label>isPerformedIn</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://example.org/music-ontology#isPlayedBy -->

    <owl:ObjectProperty rdf:about="http://example.org/music-ontology#isPlayedBy">
        <owl:inverseOf rdf:resource="http://example.org/music-ontology#playsInstrument"/>
        <rdfs:domain rdf:resource="http://example.org/music-ontology#Instrument"/>
        <rdfs:range rdf:resource="http://example.org/music-ontology#Musician"/>
        <rdfs:comment>Inverse of playsIntrument</rdfs:comment>
        <rdfs:label>isPlayedBy</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://example.org/music-ontology#isProducerOf -->

    <owl:ObjectProperty rdf:about="http://example.org/music-ontology#isProducerOf">
        <owl:inverseOf rdf:resource="http://example.org/music-ontology#producedBy"/>
        <rdfs:domain rdf:resource="http://example.org/music-ontology#Producer"/>
        <rdfs:range rdf:resource="http://example.org/music-ontology#MusicWork"/>
        <rdfs:comment>Inverse of producedBy</rdfs:comment>
        <rdfs:label>isProducerOf</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://example.org/music-ontology#isProgramItemOf -->

    <owl:ObjectProperty rdf:about="http://example.org/music-ontology#isProgramItemOf">
        <rdfs:domain rdf:resource="http://example.org/music-ontology#ProgramItem"/>
        <rdfs:range rdf:resource="http://example.org/music-ontology#Program"/>
        <rdfs:comment>Inverse relationship mapping a program item entry  to its concert program parent.</rdfs:comment>
        <rdfs:label>isProgramItemOf</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://example.org/music-ontology#isRecordingVenueFor -->

    <owl:ObjectProperty rdf:about="http://example.org/music-ontology#isRecordingVenueFor">
        <owl:inverseOf rdf:resource="http://example.org/music-ontology#recordedAt"/>
        <rdfs:domain rdf:resource="http://example.org/music-ontology#Venue"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://example.org/music-ontology#Album"/>
                    <rdf:Description rdf:about="http://example.org/music-ontology#Track"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:comment>Inverse of Recorded At</rdfs:comment>
        <rdfs:label>isRecordingVenue</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://example.org/music-ontology#isSettingFor -->

    <owl:ObjectProperty rdf:about="http://example.org/music-ontology#isSettingFor">
        <rdfs:domain rdf:resource="http://example.org/music-ontology#Situation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:comment>Points from a situation wrapper instance to define the context entities locked inside that snapshot state</rdfs:comment>
        <rdfs:label>isSettingFor</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://example.org/music-ontology#occursDuring -->

    <owl:ObjectProperty rdf:about="http://example.org/music-ontology#occursDuring">
        <rdfs:domain rdf:resource="http://example.org/music-ontology#Tour"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://example.org/music-ontology#Concert"/>
                    <rdf:Description rdf:about="http://example.org/music-ontology#MusicFestival"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:comment>Inverse of isPartOfTour, mapping a tour to its concerts</rdfs:comment>
        <rdfs:label>occursDuring</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://example.org/music-ontology#participatesIn -->

    <owl:ObjectProperty rdf:about="http://example.org/music-ontology#participatesIn">
        <rdfs:domain rdf:resource="http://example.org/music-ontology#Person"/>
        <rdfs:range rdf:resource="http://example.org/music-ontology#Event"/>
        <rdfs:comment>Directly links a person out to a event they took part in</rdfs:comment>
        <rdfs:label>participatesIn</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://example.org/music-ontology#performsTrack -->

    <owl:ObjectProperty rdf:about="http://example.org/music-ontology#performsTrack">
        <rdfs:domain rdf:resource="http://example.org/music-ontology#Concert"/>
        <rdfs:range rdf:resource="http://example.org/music-ontology#Track"/>
        <rdfs:comment>Connects a live music concert execution directly to the track song played on stage</rdfs:comment>
        <rdfs:label>performsTrack</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://example.org/music-ontology#playsInstrument -->

    <owl:ObjectProperty rdf:about="http://example.org/music-ontology#playsInstrument">
        <rdfs:domain rdf:resource="http://example.org/music-ontology#Musician"/>
        <rdfs:range rdf:resource="http://example.org/music-ontology#Instrument"/>
        <rdfs:comment>Links a performing musician individual directly to the type of musical instruments they play</rdfs:comment>
        <rdfs:label>playsInstrument</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://example.org/music-ontology#producedBy -->

    <owl:ObjectProperty rdf:about="http://example.org/music-ontology#producedBy">
        <rdfs:domain rdf:resource="http://example.org/music-ontology#MusicWork"/>
        <rdfs:range rdf:resource="http://example.org/music-ontology#Producer"/>
        <rdfs:comment>Links Producer with the music work</rdfs:comment>
        <rdfs:label>producedBy</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://example.org/music-ontology#receivedAward -->

    <owl:ObjectProperty rdf:about="http://example.org/music-ontology#receivedAward">
        <rdfs:domain rdf:resource="http://example.org/music-ontology#Person"/>
        <rdfs:range rdf:resource="http://example.org/music-ontology#Award"/>
        <rdfs:comment>Links person to the award they received</rdfs:comment>
        <rdfs:label>receivedAward</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://example.org/music-ontology#recordedAt -->

    <owl:ObjectProperty rdf:about="http://example.org/music-ontology#recordedAt">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://example.org/music-ontology#Album"/>
                    <rdf:Description rdf:about="http://example.org/music-ontology#Track"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://example.org/music-ontology#Venue"/>
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="http://example.org/music-ontology#participatesIn"/>
            <rdf:Description rdf:about="http://example.org/music-ontology#hostedAt"/>
        </owl:propertyChainAxiom>
        <rdfs:comment>Identifies the venue location where an album or specific audio track was captured</rdfs:comment>
        <rdfs:label>recordedAt</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://example.org/music-ontology#releasedUnder -->

    <owl:ObjectProperty rdf:about="http://example.org/music-ontology#releasedUnder">
        <rdfs:domain rdf:resource="http://example.org/music-ontology#MusicWork"/>
        <rdfs:range rdf:resource="http://example.org/music-ontology#RecordLabel"/>
        <rdfs:comment>Maps Album or track to the record label</rdfs:comment>
        <rdfs:label>releasedUnder</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://example.org/music-ontology#trackIsPartOf -->

    <owl:ObjectProperty rdf:about="http://example.org/music-ontology#trackIsPartOf">
        <rdfs:domain rdf:resource="http://example.org/music-ontology#Track"/>
        <rdfs:comment>inverse mapping locating a track song up into its parent album or playlist</rdfs:comment>
        <rdfs:label>trackIsPartOf</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://example.org/music-ontology#audienceCount -->

    <owl:DatatypeProperty rdf:about="http://example.org/music-ontology#audienceCount">
        <rdfs:domain rdf:resource="http://example.org/music-ontology#Event"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment>number of people at event</rdfs:comment>
        <rdfs:label>audienceCount</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://example.org/music-ontology#biography -->

    <owl:DatatypeProperty rdf:about="http://example.org/music-ontology#biography">
        <rdfs:domain rdf:resource="http://example.org/music-ontology#Person"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>short summary of artist</rdfs:comment>
        <rdfs:label>bibliography</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://example.org/music-ontology#birthDate -->

    <owl:DatatypeProperty rdf:about="http://example.org/music-ontology#birthDate">
        <rdfs:domain rdf:resource="http://example.org/music-ontology#Person"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
        <rdfs:comment>calendar data of when person was born</rdfs:comment>
        <rdfs:label>Birthdate</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://example.org/music-ontology#capacity -->

    <owl:DatatypeProperty rdf:about="http://example.org/music-ontology#capacity">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://example.org/music-ontology#Venue"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#positiveInteger"/>
        <rdfs:comment>maximum number of people possible at a venue</rdfs:comment>
        <rdfs:label>capacity</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://example.org/music-ontology#description -->

    <owl:DatatypeProperty rdf:about="http://example.org/music-ontology#description">
        <rdfs:domain rdf:resource="http://example.org/music-ontology#Concert"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Description of a concert</rdfs:comment>
        <rdfs:label>Description</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://example.org/music-ontology#durationInSeconds -->

    <owl:DatatypeProperty rdf:about="http://example.org/music-ontology#durationInSeconds">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://example.org/music-ontology#Track"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#positiveInteger"/>
        <rdfs:comment>exact seconds of a track</rdfs:comment>
        <rdfs:label>durationInSeconds</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://example.org/music-ontology#entityCode -->

    <owl:DatatypeProperty rdf:about="http://example.org/music-ontology#entityCode">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://example.org/music-ontology#Event"/>
                    <rdf:Description rdf:about="http://example.org/music-ontology#MusicWork"/>
                    <rdf:Description rdf:about="http://example.org/music-ontology#Venue"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment>A standard numeric business key used for unique class identification keys</rdfs:comment>
        <rdfs:label>entityCode</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://example.org/music-ontology#eventDate -->

    <owl:DatatypeProperty rdf:about="http://example.org/music-ontology#eventDate">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://example.org/music-ontology#Event"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
        <rdfs:comment>Calendar Date of event</rdfs:comment>
        <rdfs:label>eventDate</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://example.org/music-ontology#eventTime -->

    <owl:DatatypeProperty rdf:about="http://example.org/music-ontology#eventTime">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://example.org/music-ontology#Event"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#time"/>
        <rdfs:comment>Timestamp of when an event starts</rdfs:comment>
        <rdfs:label>eventTime</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://example.org/music-ontology#firstName -->

    <owl:DatatypeProperty rdf:about="http://example.org/music-ontology#firstName">
        <rdfs:domain rdf:resource="http://example.org/music-ontology#Person"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Given name of a person</rdfs:comment>
        <rdfs:label>firstName</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://example.org/music-ontology#id -->

    <owl:DatatypeProperty rdf:about="http://example.org/music-ontology#id">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://example.org/music-ontology#Musician"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment>Functional PK for a musician</rdfs:comment>
        <rdfs:label>id</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://example.org/music-ontology#instrumentType -->

    <owl:DatatypeProperty rdf:about="http://example.org/music-ontology#instrumentType">
        <rdfs:domain rdf:resource="http://example.org/music-ontology#Instrument"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Classification of the category of an instrument</rdfs:comment>
        <rdfs:label>instrumentType</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://example.org/music-ontology#lastName -->

    <owl:DatatypeProperty rdf:about="http://example.org/music-ontology#lastName">
        <rdfs:domain rdf:resource="http://example.org/music-ontology#Person"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Legal surmane of a Person</rdfs:comment>
        <rdfs:label>lastName</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://example.org/music-ontology#location -->

    <owl:DatatypeProperty rdf:about="http://example.org/music-ontology#location">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://example.org/music-ontology#RecordLabel"/>
                    <rdf:Description rdf:about="http://example.org/music-ontology#Venue"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Geographical location of a venue or recoed label</rdfs:comment>
        <rdfs:label>location</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://example.org/music-ontology#name -->

    <owl:DatatypeProperty rdf:about="http://example.org/music-ontology#name">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://example.org/music-ontology#Album"/>
                    <rdf:Description rdf:about="http://example.org/music-ontology#Event"/>
                    <rdf:Description rdf:about="http://example.org/music-ontology#MusicWork"/>
                    <rdf:Description rdf:about="http://example.org/music-ontology#Venue"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>General name to identify several entities</rdfs:comment>
        <rdfs:label>name</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://example.org/music-ontology#nationality -->

    <owl:DatatypeProperty rdf:about="http://example.org/music-ontology#nationality">
        <rdfs:domain rdf:resource="http://example.org/music-ontology#Person"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Nationality of a person</rdfs:comment>
        <rdfs:label>nationality</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://example.org/music-ontology#position -->

    <owl:DatatypeProperty rdf:about="http://example.org/music-ontology#position">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://example.org/music-ontology#Track"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#positiveInteger"/>
        <rdfs:comment>Sorting Index of a track</rdfs:comment>
        <rdfs:label>position</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://example.org/music-ontology#rating -->

    <owl:DatatypeProperty rdf:about="http://example.org/music-ontology#rating">
        <rdfs:domain rdf:resource="http://example.org/music-ontology#MusicWork"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment>rating of song from 0 to 10</rdfs:comment>
        <rdfs:label>rating</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://example.org/music-ontology#releaseYear -->

    <owl:DatatypeProperty rdf:about="http://example.org/music-ontology#releaseYear">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://example.org/music-ontology#Album"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#gYear"/>
        <rdfs:comment>Calendar year when album was released</rdfs:comment>
        <rdfs:label>releaseYear</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://example.org/music-ontology#ticketPrice -->

    <owl:DatatypeProperty rdf:about="http://example.org/music-ontology#ticketPrice">
        <rdfs:domain rdf:resource="http://example.org/music-ontology#Concert"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment>Price in euros of ticket for concert</rdfs:comment>
        <rdfs:label>ticketPrice</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://example.org/music-ontology#title -->

    <owl:DatatypeProperty rdf:about="http://example.org/music-ontology#title">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://example.org/music-ontology#Album"/>
                    <rdf:Description rdf:about="http://example.org/music-ontology#Concert"/>
                    <rdf:Description rdf:about="http://example.org/music-ontology#MusicWork"/>
                    <rdf:Description rdf:about="http://example.org/music-ontology#Track"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>title for events or music works</rdfs:comment>
        <rdfs:label>title</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://example.org/music-ontology#trackCount -->

    <owl:DatatypeProperty rdf:about="http://example.org/music-ontology#trackCount">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#positiveInteger"/>
        <rdfs:comment>number of tracks in Album or playlist</rdfs:comment>
        <rdfs:label>trackCount</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://example.org/music-ontology#Album -->

    <owl:Class rdf:about="http://example.org/music-ontology#Album">
        <rdfs:subClassOf rdf:resource="http://example.org/music-ontology#MusicWork"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://example.org/music-ontology#hasTrack"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="http://example.org/music-ontology#Track"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>A structured commercial music collection containing at least one track entry</rdfs:comment>
        <rdfs:label>Album</rdfs:label>
    </owl:Class>
    


    <!-- http://example.org/music-ontology#Arena -->

    <owl:Class rdf:about="http://example.org/music-ontology#Arena">
        <rdfs:subClassOf rdf:resource="http://example.org/music-ontology#Venue"/>
        <rdfs:comment>An enclosed indoor venue structure optimized for standard touring events</rdfs:comment>
        <rdfs:label>Arena</rdfs:label>
    </owl:Class>
    


    <!-- http://example.org/music-ontology#Award -->

    <owl:Class rdf:about="http://example.org/music-ontology#Award">
        <rdfs:comment>formal designation distinction or trophy accolade awarded to an entity</rdfs:comment>
        <rdfs:label>Award</rdfs:label>
    </owl:Class>
    


    <!-- http://example.org/music-ontology#AwardSituation -->

    <owl:Class rdf:about="http://example.org/music-ontology#AwardSituation">
        <rdfs:subClassOf rdf:resource="http://example.org/music-ontology#Situation"/>
        <rdfs:comment>A reified situation pattern context capturing a specific historic award win event occurrence</rdfs:comment>
        <rdfs:label>AwardSituation</rdfs:label>
    </owl:Class>
    


    <!-- http://example.org/music-ontology#Band -->

    <owl:Class rdf:about="http://example.org/music-ontology#Band">
        <rdfs:subClassOf rdf:resource="http://example.org/music-ontology#Musician"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://example.org/music-ontology#hasMember"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="http://example.org/music-ontology#SoloArtist"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="http://example.org/music-ontology#SoloArtist"/>
        <rdfs:comment>A musical collective ensemble containing at least two individual artists</rdfs:comment>
        <rdfs:label>Band</rdfs:label>
    </owl:Class>
    


    <!-- http://example.org/music-ontology#BrassInstrument -->

    <owl:Class rdf:about="http://example.org/music-ontology#BrassInstrument">
        <rdfs:subClassOf rdf:resource="http://example.org/music-ontology#Instrument"/>
        <rdfs:comment>A specialized type of instrument producing sound via lip vibration across a tubular framework</rdfs:comment>
        <rdfs:label>BrassInstrument</rdfs:label>
    </owl:Class>
    


    <!-- http://example.org/music-ontology#CollaborationSituation -->

    <owl:Class rdf:about="http://example.org/music-ontology#CollaborationSituation">
        <rdfs:subClassOf rdf:resource="http://example.org/music-ontology#Situation"/>
        <rdfs:comment>A reified situation capturing distinct creative actions shared across joint musicians</rdfs:comment>
        <rdfs:label>CollaborationSituation</rdfs:label>
    </owl:Class>
    


    <!-- http://example.org/music-ontology#Composer -->

    <owl:Class rdf:about="http://example.org/music-ontology#Composer">
        <rdfs:subClassOf rdf:resource="http://example.org/music-ontology#Person"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://example.org/music-ontology#createdWork"/>
                <owl:someValuesFrom rdf:resource="http://example.org/music-ontology#MusicWork"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>A person who actively writes, designs, or composes musical work structures</rdfs:comment>
        <rdfs:label>Composer</rdfs:label>
    </owl:Class>
    


    <!-- http://example.org/music-ontology#CompositionParticipation -->

    <owl:Class rdf:about="http://example.org/music-ontology#CompositionParticipation">
        <rdfs:subClassOf rdf:resource="http://example.org/music-ontology#Participation"/>
        <rdfs:comment>A localized participation pattern subclass tracking authorship composition involvement</rdfs:comment>
        <rdfs:label>CompositionParticipation</rdfs:label>
    </owl:Class>
    


    <!-- http://example.org/music-ontology#Concert -->

    <owl:Class rdf:about="http://example.org/music-ontology#Concert">
        <rdfs:subClassOf rdf:resource="http://example.org/music-ontology#Event"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://example.org/music-ontology#hostedAt"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://example.org/music-ontology#Venue"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="http://example.org/music-ontology#Genre"/>
        <rdfs:comment xml:lang="en">A live music performance event at a Venue, which must have exactly one Venue (functional hostedAt). Concerts can be part of Tours and have a Program.</rdfs:comment>
        <rdfs:label>concert</rdfs:label>
    </owl:Class>
    


    <!-- http://example.org/music-ontology#ConcertHall -->

    <owl:Class rdf:about="http://example.org/music-ontology#ConcertHall">
        <rdfs:subClassOf rdf:resource="http://example.org/music-ontology#Venue"/>
        <rdfs:comment>An indoor venue structurally tailored specifically for optimal acoustics and classical performances</rdfs:comment>
        <rdfs:label>ConcertHall</rdfs:label>
    </owl:Class>
    


    <!-- http://example.org/music-ontology#Drums -->

    <owl:Class rdf:about="http://example.org/music-ontology#Drums">
        <rdfs:subClassOf rdf:resource="http://example.org/music-ontology#PercussionInstrument"/>
        <rdfs:comment>A definitive percussion instrument family producing rhythmic sound via striking membranes</rdfs:comment>
        <rdfs:label>Drums</rdfs:label>
    </owl:Class>
    


    <!-- http://example.org/music-ontology#EP -->

    <owl:Class rdf:about="http://example.org/music-ontology#EP">
        <rdfs:subClassOf rdf:resource="http://example.org/music-ontology#Album"/>
        <rdfs:comment>Extended Play collection format, reflecting a mid-length album entry</rdfs:comment>
        <rdfs:label>EP</rdfs:label>
    </owl:Class>
    


    <!-- http://example.org/music-ontology#ElectronicGenre -->

    <owl:Class rdf:about="http://example.org/music-ontology#ElectronicGenre">
        <rdfs:subClassOf rdf:resource="http://example.org/music-ontology#Genre"/>
        <rdfs:comment>A music genre grouping capturing electronic synthesizers and digital production</rdfs:comment>
        <rdfs:label>ElectronicGenre</rdfs:label>
    </owl:Class>
    


    <!-- http://example.org/music-ontology#Event -->

    <owl:Class rdf:about="http://example.org/music-ontology#Event">
        <owl:hasKey rdf:parseType="Collection">
            <rdf:Description rdf:about="http://example.org/music-ontology#entityCode"/>
        </owl:hasKey>
        <rdfs:comment xml:lang="en">A scheduled occurrence. Subclasses: Concert, MusicFestival, Tour,  RecordingSession. Has key: entityCode.</rdfs:comment>
        <rdfs:label>Event</rdfs:label>
    </owl:Class>
    


    <!-- http://example.org/music-ontology#Flute -->

    <owl:Class rdf:about="http://example.org/music-ontology#Flute">
        <rdfs:subClassOf rdf:resource="http://example.org/music-ontology#WoodwindInstrument"/>
        <rdfs:comment>A definitive woodwind instrument family producing sound via air stream splitting</rdfs:comment>
        <rdfs:label>Flute</rdfs:label>
    </owl:Class>
    


    <!-- http://example.org/music-ontology#Genre -->

    <owl:Class rdf:about="http://example.org/music-ontology#Genre">
        <rdfs:comment>The category classification  musical identity traits</rdfs:comment>
        <rdfs:label>Genre</rdfs:label>
    </owl:Class>
    


    <!-- http://example.org/music-ontology#Guitar -->

    <owl:Class rdf:about="http://example.org/music-ontology#Guitar">
        <rdfs:subClassOf rdf:resource="http://example.org/music-ontology#StringInstrument"/>
        <rdfs:comment>A definitive string instrument family producing sound via plucked strings</rdfs:comment>
        <rdfs:label>Guitar</rdfs:label>
    </owl:Class>
    


    <!-- http://example.org/music-ontology#Instrument -->

    <owl:Class rdf:about="http://example.org/music-ontology#Instrument">
        <rdfs:comment>Instruments used by musicians</rdfs:comment>
        <rdfs:label>Instrument</rdfs:label>
    </owl:Class>
    


    <!-- http://example.org/music-ontology#KeyboardsInstrument -->

    <owl:Class rdf:about="http://example.org/music-ontology#KeyboardsInstrument">
        <rdfs:subClassOf rdf:resource="http://example.org/music-ontology#Instrument"/>
        <rdfs:comment>An instrument family characterized by standard structural rows of input keys</rdfs:comment>
        <rdfs:label>KeyboardsInstrument</rdfs:label>
    </owl:Class>
    


    <!-- http://example.org/music-ontology#LatinGenre -->

    <owl:Class rdf:about="http://example.org/music-ontology#LatinGenre">
        <rdfs:subClassOf rdf:resource="http://example.org/music-ontology#Genre"/>
        <rdfs:comment>Style from ibero-latin countries</rdfs:comment>
        <rdfs:label>LatinGenre</rdfs:label>
    </owl:Class>
    


    <!-- http://example.org/music-ontology#LiveAlbum -->

    <owl:Class rdf:about="http://example.org/music-ontology#LiveAlbum">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://example.org/music-ontology#Album"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://example.org/music-ontology#recordedAt"/>
                        <owl:someValuesFrom rdf:resource="http://example.org/music-ontology#Concert"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://example.org/music-ontology#Album"/>
        <owl:disjointWith rdf:resource="http://example.org/music-ontology#StudioAlbum"/>
        <rdfs:comment xml:lang="en">An Album recorded at a Concert venue (defined class). Equivalent to Album AND (recordedAt some Concert).</rdfs:comment>
        <rdfs:label>LiveAlbum</rdfs:label>
    </owl:Class>
    


    <!-- http://example.org/music-ontology#MembershipSituation -->

    <owl:Class rdf:about="http://example.org/music-ontology#MembershipSituation">
        <rdfs:subClassOf rdf:resource="http://example.org/music-ontology#Situation"/>
        <rdfs:comment>A reified situation capturing musicians inside groups</rdfs:comment>
        <rdfs:label>MembershipSituation</rdfs:label>
    </owl:Class>
    


    <!-- http://example.org/music-ontology#MusicFestival -->

    <owl:Class rdf:about="http://example.org/music-ontology#MusicFestival">
        <rdfs:subClassOf rdf:resource="http://example.org/music-ontology#Event"/>
        <rdfs:comment>A large macro event hosting multi-day distinct scheduled concurrent concerts</rdfs:comment>
        <rdfs:label>MusicFestival</rdfs:label>
    </owl:Class>
    


    <!-- http://example.org/music-ontology#MusicWork -->

    <owl:Class rdf:about="http://example.org/music-ontology#MusicWork">
        <owl:hasKey rdf:parseType="Collection">
            <rdf:Description rdf:about="http://example.org/music-ontology#entityCode"/>
        </owl:hasKey>
        <rdfs:comment>The top-level creative abstract or physical intellectual media asset</rdfs:comment>
        <rdfs:label>MusicWork</rdfs:label>
    </owl:Class>
    


    <!-- http://example.org/music-ontology#Musician -->

    <owl:Class rdf:about="http://example.org/music-ontology#Musician">
        <rdfs:subClassOf rdf:resource="http://example.org/music-ontology#Person"/>
        <owl:hasKey rdf:parseType="Collection">
            <rdf:Description rdf:about="http://example.org/music-ontology#id"/>
        </owl:hasKey>
        <rdfs:comment xml:lang="en">A Person who performs music. Subtypes: SoloArtist, Band, Orchestra. SoloArtist, Band, and Orchestra are pairwise disjoint. Has key: id.</rdfs:comment>
        <rdfs:label>Musician</rdfs:label>
    </owl:Class>
    


    <!-- http://example.org/music-ontology#OutdoorVenue -->

    <owl:Class rdf:about="http://example.org/music-ontology#OutdoorVenue">
        <rdfs:subClassOf rdf:resource="http://example.org/music-ontology#Venue"/>
        <rdfs:comment>A venue classification category covering un-roofed or open air concert</rdfs:comment>
        <rdfs:label>OutdoorVenue</rdfs:label>
    </owl:Class>
    


    <!-- http://example.org/music-ontology#Participation -->

    <owl:Class rdf:about="http://example.org/music-ontology#Participation">
        <rdfs:comment xml:lang="en">ODP: Participation Pattern. Reifies the participation of a Person in an Event with a specific role. Avoids n-ary relation problems. A Participation instance links one Person to one Event with a typed role.</rdfs:comment>
        <rdfs:label>Participation</rdfs:label>
    </owl:Class>
    


    <!-- http://example.org/music-ontology#PercussionInstrument -->

    <owl:Class rdf:about="http://example.org/music-ontology#PercussionInstrument">
        <rdfs:subClassOf rdf:resource="http://example.org/music-ontology#Instrument"/>
        <rdfs:comment>An instrument family producing musical notes via striking, scraping, or shaking</rdfs:comment>
