    <!-- http://example.org/music-ontology#RockGenre -->

    <owl:Class rdf:about="http://example.org/music-ontology#RockGenre">
        <rdfs:subClassOf rdf:resource="http://example.org/music-ontology#Genre"/>
        <rdfs:comment>A definitive stylistic energetic music genre group classification</rdfs:comment>
        <rdfs:label>RockGenre</rdfs:label>
    </owl:Class>
    


    <!-- http://example.org/music-ontology#Situation -->

    <owl:Class rdf:about="http://example.org/music-ontology#Situation">
        <rdfs:comment xml:lang="en">ODP: Typed Situation Pattern (Observation). A Situation reifies a complex state of affairs involving Persons and MusicWorks. Subtypes include AwardSituation (when an Award is given to a Person), CollaborationSituation (when Musicians collaborate), and MembershipSituation (when a Musician joins a Band/Orchestra).</rdfs:comment>
        <rdfs:label>Situation</rdfs:label>
    </owl:Class>
    


    <!-- http://example.org/music-ontology#SoloArtist -->

    <owl:Class rdf:about="http://example.org/music-ontology#SoloArtist">
        <rdfs:subClassOf rdf:resource="http://example.org/music-ontology#Musician"/>
        <rdfs:comment>An individual musician conducting independent or single performance</rdfs:comment>
        <rdfs:label>SoloArtist</rdfs:label>
    </owl:Class>
    


    <!-- http://example.org/music-ontology#Stadium -->

    <owl:Class rdf:about="http://example.org/music-ontology#Stadium">
        <rdfs:subClassOf rdf:resource="http://example.org/music-ontology#Venue"/>
        <rdfs:comment>A massive open-air venue structure tailored specifically for large-scale mega-tours</rdfs:comment>
        <rdfs:label>Stadium</rdfs:label>
    </owl:Class>
    


    <!-- http://example.org/music-ontology#StringInstrument -->

    <owl:Class rdf:about="http://example.org/music-ontology#StringInstrument">
        <rdfs:subClassOf rdf:resource="http://example.org/music-ontology#Instrument"/>
        <rdfs:comment>An instrument family producing notes via string vibration</rdfs:comment>
        <rdfs:label>StringInstrument</rdfs:label>
    </owl:Class>
    


    <!-- http://example.org/music-ontology#Studio -->

    <owl:Class rdf:about="http://example.org/music-ontology#Studio">
        <rdfs:subClassOf rdf:resource="http://example.org/music-ontology#Venue"/>
        <rdfs:comment>A specialized indoor recording environment optimized for commercial audio tracking captures</rdfs:comment>
        <rdfs:label>Studio</rdfs:label>
    </owl:Class>
    


    <!-- http://example.org/music-ontology#StudioAlbum -->

    <owl:Class rdf:about="http://example.org/music-ontology#StudioAlbum">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://example.org/music-ontology#Album"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://example.org/music-ontology#recordedAt"/>
                        <owl:someValuesFrom rdf:resource="http://example.org/music-ontology#Studio"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://example.org/music-ontology#Album"/>
        <rdfs:comment xml:lang="en">An Album recorded in a Studio (defined class). Equivalent to Album AND (recordedAt some Studio). Disjoint with LiveAlbum.</rdfs:comment>
        <rdfs:label>StudioAlbum</rdfs:label>
    </owl:Class>
    


    <!-- http://example.org/music-ontology#Theater -->

    <owl:Class rdf:about="http://example.org/music-ontology#Theater">
        <rdfs:subClassOf rdf:resource="http://example.org/music-ontology#Venue"/>
        <rdfs:comment>An indoor performing arts structure typically hosting medium scaled seating concerts</rdfs:comment>
        <rdfs:label>Theater</rdfs:label>
    </owl:Class>
    


    <!-- http://example.org/music-ontology#Tour -->

    <owl:Class rdf:about="http://example.org/music-ontology#Tour">
        <rdfs:subClassOf rdf:resource="http://example.org/music-ontology#Event"/>
        <rdfs:comment>A macro structured timeline grouping ordered individual performance concert tour dates across cities</rdfs:comment>
        <rdfs:label>Tour</rdfs:label>
    </owl:Class>
    


    <!-- http://example.org/music-ontology#Track -->

    <owl:Class rdf:about="http://example.org/music-ontology#Track">
        <rdfs:subClassOf rdf:resource="http://example.org/music-ontology#MusicWork"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://example.org/music-ontology#durationInSeconds"/>
                <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>An individual distinct recorded song</rdfs:comment>
        <rdfs:label>Track</rdfs:label>
    </owl:Class>
    


    <!-- http://example.org/music-ontology#Trumpet -->

    <owl:Class rdf:about="http://example.org/music-ontology#Trumpet">
