        <rdfs:label>RecordLabel</rdfs:label>
    </owl:Class>
    


    <!-- http://example.org/music-ontology#RecordingSession -->

    <owl:Class rdf:about="http://example.org/music-ontology#RecordingSession">
        <rdfs:subClassOf rdf:resource="http://example.org/music-ontology#Event"/>
        <rdfs:comment>A scheduled production event tracking dedicated time block tracking recording inside a studio venue</rdfs:comment>
