<?xml version="1.0"?>
<rdf:RDF xmlns="http://example.org/music-ontology#"
     xml:base="http://example.org/music-ontology"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#">
    <owl:Ontology rdf:about="http://example.org/music-ontology">
        <rdfs:comment xml:lang="en">Enhanced Music Ontology for SAIKS Assignment SS2026. Covers concerts, tracks, composers, events, musicians, orchestras, theaters, instruments, albums, genres, tours, venues, and record labels. Uses OWL2 advanced features and three Ontology Design Patterns: Participation, Part-Of, and Typed Situation.</rdfs:comment>
        <rdfs:label xml:lang="en">Concerts and Music Ontology (Enhanced OWL2)</rdfs:label>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Datatypes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.w3.org/2001/XMLSchema#date -->

    <rdfs:Datatype rdf:about="http://www.w3.org/2001/XMLSchema#date"/>
    


    <!-- http://www.w3.org/2001/XMLSchema#gYear -->

    <rdfs:Datatype rdf:about="http://www.w3.org/2001/XMLSchema#gYear"/>
    


    <!-- http://www.w3.org/2001/XMLSchema#time -->

    <rdfs:Datatype rdf:about="http://www.w3.org/2001/XMLSchema#time"/>
    


    <!-- xsd:decimal -->

    <rdfs:Datatype rdf:about="xsd:decimal"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://example.org/music-ontology#ReleasedUnder -->

    <owl:ObjectProperty rdf:about="http://example.org/music-ontology#ReleasedUnder">
        <owl:inverseOf rdf:resource="http://example.org/music-ontology#hasReleased"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://example.org/music-ontology#Album"/>
                    <rdf:Description rdf:about="http://example.org/music-ontology#MusicWork"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://example.org/music-ontology#RecordLabel"/>
    </owl:ObjectProperty>
    


    <!-- http://example.org/music-ontology#awardGivenTo -->

    <owl:ObjectProperty rdf:about="http://example.org/music-ontology#awardGivenTo">
        <owl:inverseOf rdf:resource="http://example.org/music-ontology#receivedAward"/>
    </owl:ObjectProperty>
    


    <!-- http://example.org/music-ontology#collaboratedWith -->

    <owl:ObjectProperty rdf:about="http://example.org/music-ontology#collaboratedWith">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ReflexiveProperty"/>
        <rdfs:domain rdf:resource="http://example.org/music-ontology#Musician"/>
        <rdfs:range rdf:resource="http://example.org/music-ontology#Musician"/>
    </owl:ObjectProperty>
    


    <!-- http://example.org/music-ontology#createdWork -->

    <owl:ObjectProperty rdf:about="http://example.org/music-ontology#createdWork">
        <owl:inverseOf rdf:resource="http://example.org/music-ontology#hasCreator"/>
        <rdfs:domain rdf:resource="http://example.org/music-ontology#Person"/>
        <rdfs:range rdf:resource="http://example.org/music-ontology#MusicWork"/>
    </owl:ObjectProperty>
    


    <!-- http://example.org/music-ontology#featuresArtist -->

    <owl:ObjectProperty rdf:about="http://example.org/music-ontology#featuresArtist">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://example.org/music-ontology#Album"/>
                    <rdf:Description rdf:about="http://example.org/music-ontology#Event"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://example.org/music-ontology#Musician"/>
    </owl:ObjectProperty>
    


    <!-- http://example.org/music-ontology#hasCreator -->

    <owl:ObjectProperty rdf:about="http://example.org/music-ontology#hasCreator">
        <rdfs:domain rdf:resource="http://example.org/music-ontology#MusicWork"/>
        <rdfs:range rdf:resource="http://example.org/music-ontology#Person"/>
    </owl:ObjectProperty>
    


    <!-- http://example.org/music-ontology#hasGenre -->

    <owl:ObjectProperty rdf:about="http://example.org/music-ontology#hasGenre">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:domain rdf:resource="http://example.org/music-ontology#MusicWork"/>
        <rdfs:range rdf:resource="http://example.org/music-ontology#Genre"/>
    </owl:ObjectProperty>
    


    <!-- http://example.org/music-ontology#hasMember -->

    <owl:ObjectProperty rdf:about="http://example.org/music-ontology#hasMember">
        <owl:inverseOf rdf:resource="http://example.org/music-ontology#isMemberOf"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://example.org/music-ontology#Band"/>
                    <rdf:Description rdf:about="http://example.org/music-ontology#Orchestra"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://example.org/music-ontology#Musician"/>
    </owl:ObjectProperty>
    


    <!-- http://example.org/music-ontology#hasParticipant -->

    <owl:ObjectProperty rdf:about="http://example.org/music-ontology#hasParticipant">
        <owl:inverseOf rdf:resource="http://example.org/music-ontology#participatesIn"/>
        <rdfs:domain rdf:resource="http://example.org/music-ontology#Event"/>
        <rdfs:range rdf:resource="http://example.org/music-ontology#Person"/>
    </owl:ObjectProperty>
    


    <!-- http://example.org/music-ontology#hasParticipation -->

    <owl:ObjectProperty rdf:about="http://example.org/music-ontology#hasParticipation">
        <owl:inverseOf rdf:resource="http://example.org/music-ontology#isParticipationOf"/>
        <rdfs:domain rdf:resource="http://example.org/music-ontology#Person"/>
        <rdfs:range rdf:resource="http://example.org/music-ontology#Participation"/>
    </owl:ObjectProperty>
    


    <!-- http://example.org/music-ontology#hasProgramItem -->

    <owl:ObjectProperty rdf:about="http://example.org/music-ontology#hasProgramItem">
        <owl:inverseOf rdf:resource="http://example.org/music-ontology#isProgramItemOf"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:domain rdf:resource="http://example.org/music-ontology#Program"/>
        <rdfs:range rdf:resource="http://example.org/music-ontology#ProgramItem"/>
    </owl:ObjectProperty>
    


    <!-- http://example.org/music-ontology#hasReleased -->

    <owl:ObjectProperty rdf:about="http://example.org/music-ontology#hasReleased">
        <rdfs:domain rdf:resource="http://example.org/music-ontology#RecordLabel"/>
        <rdfs:range rdf:resource="http://example.org/music-ontology#Album"/>
    </owl:ObjectProperty>
    


    <!-- http://example.org/music-ontology#hasRole -->

    <owl:ObjectProperty rdf:about="http://example.org/music-ontology#hasRole"/>
    


    <!-- http://example.org/music-ontology#hasSetList -->

    <owl:ObjectProperty rdf:about="http://example.org/music-ontology#hasSetList"/>
    


    <!-- http://example.org/music-ontology#hasSetting -->

    <owl:ObjectProperty rdf:about="http://example.org/music-ontology#hasSetting">
        <owl:inverseOf rdf:resource="http://example.org/music-ontology#isSettingFor"/>
    </owl:ObjectProperty>
    


    <!-- http://example.org/music-ontology#hasTrack -->

    <owl:ObjectProperty rdf:about="http://example.org/music-ontology#hasTrack">
        <owl:inverseOf rdf:resource="http://example.org/music-ontology#trackIsPartOf"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://example.org/music-ontology#Album"/>
                    <rdf:Description rdf:about="http://example.org/music-ontology#Playlist"/>
                    <rdf:Description rdf:about="http://example.org/music-ontology#SetList"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://example.org/music-ontology#Track"/>
    </owl:ObjectProperty>
    


    <!-- http://example.org/music-ontology#hearsInstrument -->

    <owl:ObjectProperty rdf:about="http://example.org/music-ontology#hearsInstrument">
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="http://example.org/music-ontology#featuresArtist"/>
            <rdf:Description rdf:about="http://example.org/music-ontology#playsInstrument"/>
        </owl:propertyChainAxiom>
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="http://example.org/music-ontology#hasMember"/>
            <rdf:Description rdf:about="http://example.org/music-ontology#playsInstrument"/>
        </owl:propertyChainAxiom>
    </owl:ObjectProperty>
    


    <!-- http://example.org/music-ontology#hostedAt -->

    <owl:ObjectProperty rdf:about="http://example.org/music-ontology#hostedAt">
        <owl:inverseOf rdf:resource="http://example.org/music-ontology#hostedEvent"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://example.org/music-ontology#Event"/>
        <rdfs:range rdf:resource="http://example.org/music-ontology#Venue"/>
    </owl:ObjectProperty>
    


    <!-- http://example.org/music-ontology#hostedEvent -->

    <owl:ObjectProperty rdf:about="http://example.org/music-ontology#hostedEvent">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#InverseFunctionalProperty"/>
        <rdfs:domain rdf:resource="http://example.org/music-ontology#Venue"/>
        <rdfs:range rdf:resource="http://example.org/music-ontology#Event"/>
    </owl:ObjectProperty>
    


    <!-- http://example.org/music-ontology#involvesMusicWork -->

    <owl:ObjectProperty rdf:about="http://example.org/music-ontology#involvesMusicWork">
        <rdfs:domain rdf:resource="http://example.org/music-ontology#Situation"/>
        <rdfs:range rdf:resource="http://example.org/music-ontology#MusicWork"/>
    </owl:ObjectProperty>
    


    <!-- http://example.org/music-ontology#involvesPerson -->

    <owl:ObjectProperty rdf:about="http://example.org/music-ontology#involvesPerson">
        <rdfs:domain rdf:resource="http://example.org/music-ontology#Situation"/>
        <rdfs:range rdf:resource="http://example.org/music-ontology#Person"/>
    </owl:ObjectProperty>
    


    <!-- http://example.org/music-ontology#isMemberOf -->

    <owl:ObjectProperty rdf:about="http://example.org/music-ontology#isMemberOf">
        <rdfs:domain rdf:resource="http://example.org/music-ontology#Musician"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://example.org/music-ontology#Band"/>
                    <rdf:Description rdf:about="http://example.org/music-ontology#Orchestra"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
    </owl:ObjectProperty>
    


    <!-- http://example.org/music-ontology#isPartOfTour -->

    <owl:ObjectProperty rdf:about="http://example.org/music-ontology#isPartOfTour">
        <owl:inverseOf rdf:resource="http://example.org/music-ontology#occursDuring"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://example.org/music-ontology#Concert"/>
                    <rdf:Description rdf:about="http://example.org/music-ontology#MusicFestival"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://example.org/music-ontology#Tour"/>
    </owl:ObjectProperty>
    


    <!-- http://example.org/music-ontology#isParticipationOf -->

    <owl:ObjectProperty rdf:about="http://example.org/music-ontology#isParticipationOf"/>
    


    <!-- http://example.org/music-ontology#isPerformedIn -->

    <owl:ObjectProperty rdf:about="http://example.org/music-ontology#isPerformedIn">
        <owl:inverseOf rdf:resource="http://example.org/music-ontology#performsTrack"/>
    </owl:ObjectProperty>
    


    <!-- http://example.org/music-ontology#isProgramItemOf -->

    <owl:ObjectProperty rdf:about="http://example.org/music-ontology#isProgramItemOf"/>
    


    <!-- http://example.org/music-ontology#isSettingFor -->

    <owl:ObjectProperty rdf:about="http://example.org/music-ontology#isSettingFor">
        <rdfs:domain rdf:resource="http://example.org/music-ontology#Situation"/>
    </owl:ObjectProperty>
    


    <!-- http://example.org/music-ontology#occursDuring -->

    <owl:ObjectProperty rdf:about="http://example.org/music-ontology#occursDuring"/>
    


    <!-- http://example.org/music-ontology#participatesIn -->

    <owl:ObjectProperty rdf:about="http://example.org/music-ontology#participatesIn">
        <rdfs:domain rdf:resource="http://example.org/music-ontology#Person"/>
        <rdfs:range rdf:resource="http://example.org/music-ontology#Event"/>
    </owl:ObjectProperty>
    


    <!-- http://example.org/music-ontology#performsTrack -->

    <owl:ObjectProperty rdf:about="http://example.org/music-ontology#performsTrack">
        <rdfs:domain rdf:resource="http://example.org/music-ontology#Concert"/>
        <rdfs:range rdf:resource="http://example.org/music-ontology#Track"/>
    </owl:ObjectProperty>
    


    <!-- http://example.org/music-ontology#playsInstrument -->

    <owl:ObjectProperty rdf:about="http://example.org/music-ontology#playsInstrument">
        <rdfs:domain rdf:resource="http://example.org/music-ontology#Musician"/>
        <rdfs:range rdf:resource="http://example.org/music-ontology#Instrument"/>
    </owl:ObjectProperty>
    


    <!-- http://example.org/music-ontology#producedBy -->

    <owl:ObjectProperty rdf:about="http://example.org/music-ontology#producedBy">
        <rdfs:domain rdf:resource="http://example.org/music-ontology#MusicWork"/>
        <rdfs:range rdf:resource="http://example.org/music-ontology#Producer"/>
    </owl:ObjectProperty>
    


    <!-- http://example.org/music-ontology#receivedAward -->

    <owl:ObjectProperty rdf:about="http://example.org/music-ontology#receivedAward">
        <rdfs:domain rdf:resource="http://example.org/music-ontology#Person"/>
        <rdfs:range rdf:resource="http://example.org/music-ontology#Award"/>
    </owl:ObjectProperty>
    


    <!-- http://example.org/music-ontology#recordedAt -->

    <owl:ObjectProperty rdf:about="http://example.org/music-ontology#recordedAt">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://example.org/music-ontology#Album"/>
                    <rdf:Description rdf:about="http://example.org/music-ontology#Track"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://example.org/music-ontology#Venue"/>
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="http://example.org/music-ontology#participatesIn"/>
            <rdf:Description rdf:about="http://example.org/music-ontology#hostedAt"/>
        </owl:propertyChainAxiom>
    </owl:ObjectProperty>
    


    <!-- http://example.org/music-ontology#trackIsPartOf -->

    <owl:ObjectProperty rdf:about="http://example.org/music-ontology#trackIsPartOf">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:domain rdf:resource="http://example.org/music-ontology#Track"/>
        <rdfs:range rdf:resource="http://example.org/music-ontology#Album"/>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://example.org/music-ontology#audienceCount -->

    <owl:DatatypeProperty rdf:about="http://example.org/music-ontology#audienceCount">
        <rdfs:domain rdf:resource="http://example.org/music-ontology#Event"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#nonNegativeInteger"/>
    </owl:DatatypeProperty>
    


    <!-- http://example.org/music-ontology#biography -->

    <owl:DatatypeProperty rdf:about="http://example.org/music-ontology#biography">
        <rdfs:domain rdf:resource="http://example.org/music-ontology#Person"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    


    <!-- http://example.org/music-ontology#birthDate -->

    <owl:DatatypeProperty rdf:about="http://example.org/music-ontology#birthDate">
        <rdfs:domain rdf:resource="http://example.org/music-ontology#Person"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
    </owl:DatatypeProperty>
    


    <!-- http://example.org/music-ontology#capacity -->

    <owl:DatatypeProperty rdf:about="http://example.org/music-ontology#capacity">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://example.org/music-ontology#Venue"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#positiveInteger"/>
    </owl:DatatypeProperty>
    


    <!-- http://example.org/music-ontology#description -->

    <owl:DatatypeProperty rdf:about="http://example.org/music-ontology#description">
        <rdfs:domain rdf:resource="http://example.org/music-ontology#Concert"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    


    <!-- http://example.org/music-ontology#durationInSeconds -->

    <owl:DatatypeProperty rdf:about="http://example.org/music-ontology#durationInSeconds">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://example.org/music-ontology#Track"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#positiveInteger"/>
    </owl:DatatypeProperty>
    


    <!-- http://example.org/music-ontology#entityCode -->

    <owl:DatatypeProperty rdf:about="http://example.org/music-ontology#entityCode">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://example.org/music-ontology#Event"/>
                    <rdf:Description rdf:about="http://example.org/music-ontology#MusicWork"/>
                    <rdf:Description rdf:about="http://example.org/music-ontology#Venue"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    </owl:DatatypeProperty>
    


    <!-- http://example.org/music-ontology#eventDate -->

    <owl:DatatypeProperty rdf:about="http://example.org/music-ontology#eventDate">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://example.org/music-ontology#Event"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
    </owl:DatatypeProperty>
    


    <!-- http://example.org/music-ontology#eventTime -->

    <owl:DatatypeProperty rdf:about="http://example.org/music-ontology#eventTime">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://example.org/music-ontology#Event"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#time"/>
    </owl:DatatypeProperty>
    


    <!-- http://example.org/music-ontology#firstName -->

    <owl:DatatypeProperty rdf:about="http://example.org/music-ontology#firstName">
        <rdfs:domain rdf:resource="http://example.org/music-ontology#Person"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    


    <!-- http://example.org/music-ontology#id -->

    <owl:DatatypeProperty rdf:about="http://example.org/music-ontology#id">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://example.org/music-ontology#Musician"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    </owl:DatatypeProperty>
    


    <!-- http://example.org/music-ontology#instrumentType -->

    <owl:DatatypeProperty rdf:about="http://example.org/music-ontology#instrumentType">
        <rdfs:domain rdf:resource="http://example.org/music-ontology#Instrument"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    


    <!-- http://example.org/music-ontology#lastName -->

    <owl:DatatypeProperty rdf:about="http://example.org/music-ontology#lastName">
        <rdfs:domain rdf:resource="http://example.org/music-ontology#Person"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    


    <!-- http://example.org/music-ontology#location -->

    <owl:DatatypeProperty rdf:about="http://example.org/music-ontology#location">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://example.org/music-ontology#RecordLabel"/>
                    <rdf:Description rdf:about="http://example.org/music-ontology#Venue"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    


    <!-- http://example.org/music-ontology#name -->

    <owl:DatatypeProperty rdf:about="http://example.org/music-ontology#name">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://example.org/music-ontology#Album"/>
                    <rdf:Description rdf:about="http://example.org/music-ontology#Event"/>
                    <rdf:Description rdf:about="http://example.org/music-ontology#MusicWork"/>
                    <rdf:Description rdf:about="http://example.org/music-ontology#Venue"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    


    <!-- http://example.org/music-ontology#nationality -->

    <owl:DatatypeProperty rdf:about="http://example.org/music-ontology#nationality">
        <rdfs:domain rdf:resource="http://example.org/music-ontology#Person"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    


    <!-- http://example.org/music-ontology#position -->

    <owl:DatatypeProperty rdf:about="http://example.org/music-ontology#position">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://example.org/music-ontology#Track"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#positiveInteger"/>
    </owl:DatatypeProperty>
    


    <!-- http://example.org/music-ontology#rating -->

    <owl:DatatypeProperty rdf:about="http://example.org/music-ontology#rating">
        <rdfs:domain rdf:resource="http://example.org/music-ontology#MusicWork"/>
        <rdfs:range>
            <rdfs:Datatype>
                <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
                <owl:withRestrictions rdf:parseType="Collection">
                    <rdf:Description>
                        <xsd:minInclusive rdf:datatype="xsd:decimal">0.0</xsd:minInclusive>
                    </rdf:Description>
                    <rdf:Description>
