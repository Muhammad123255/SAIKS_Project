@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix : <http://example.org/music-ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:ConcertShape
    a sh:NodeShape ;
    sh:targetClass :Concert ;

    sh:property [
        sh:path :title ;
        sh:minCount 1 ;
        sh:message "Concert must have a title." ;
    ] ;

    sh:property [
        sh:path :eventDate ;
        sh:minCount 1 ;
        sh:message "Concert must have an event date." ;
    ] ;

    sh:property [
        sh:path :ticketPrice ;
        sh:minCount 1 ;
        sh:datatype xsd:decimal ;
        sh:message "Concert must have a ticket price." ;
    ] .